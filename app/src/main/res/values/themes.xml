<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Prototipo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/color_fondo</item>
        <item name="android:textColorPrimary">@color/color_texto</item>
    </style>

    <style name="Theme.Prototipo" parent="Base.Theme.Prototipo" />

    <style name="BotonPrincipal" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="CampoTexto">
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_texto</item>
        <item name="android:textColorHint">@color/color_texto_suave</item>
    </style>

    <style name="TituloSeccion">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_primario</item>
    </style>
</resources>